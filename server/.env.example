NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Appointment dates and times are wall-clock times in this timezone (IANA name)
CLINIC_TIMEZONE=Asia/Kolkata
MONGODB_URI=mongodb://127.0.0.1:27017/emr_appointments

# At least 32 characters each, and different from each other. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Only used by `npm run seed -w server`: the password for every seeded account
SEED_PASSWORD=
